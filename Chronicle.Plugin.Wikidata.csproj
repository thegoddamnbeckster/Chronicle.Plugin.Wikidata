<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.1.0</Version>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Chronicle.Plugin.Wikidata</AssemblyName>
    <RootNamespace>Chronicle.Plugin.Wikidata</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private="false" / ExcludeAssets="runtime" keeps Chronicle.Plugins and Chronicle.Core out of the plugin
         output so PluginLoadContext falls through to the host's copies (see the MusicBrainz plugin's csproj). -->
    <ProjectReference Include="..\Chronicle\src\Chronicle.Plugins\Chronicle.Plugins.csproj"
                      Private="false"
                      ExcludeAssets="runtime" />
    <ProjectReference Include="..\Chronicle\src\Chronicle.Core\Chronicle.Core.csproj"
                      Private="false"
                      ExcludeAssets="runtime" />
    <!-- Serilog is loaded by the Chronicle host: reference it without bundling, pinned to the EXACT version
         Chronicle.API resolves. .NET binding is exact-version-strict. -->
    <PackageReference Include="Serilog" Version="4.3.1" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
